// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum DocumentType {
  LOGO
  BANNER
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

enum OrganizationMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum IntegrationProvider {
  GITHUB
  SLACK
  STRIPE
  HUBSPOT
  LINEAR
  NOTION
  GOOGLE_DRIVE
  SMTP
  GMAIL
  RESEND
  SENDGRID
  POSTHOG
  INTERCOM
  DATABASE_PG
  DATABASE_MYSQL
  DATABASE_MONGO
  OPENAPI
  MCP
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  MONGODB
}

enum DatabaseOperation {
  READ
  INSERT
  UPDATE
  DELETE
}

enum OpenApiAuthType {
  NONE
  API_KEY
  BEARER
  OAUTH2
  CUSTOM_HEADERS
}

enum McpTransportType {
  HTTP
  SSE
}

enum McpAuthType {
  NONE
  BEARER
  CUSTOM_HEADERS
  OAUTH
}

enum AiProviderType {
  OPENAI
  CLAUDE
  GROK
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AgentExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  AWAITING_APPROVAL
}

enum ToolCallStatus {
  SUCCESS
  FAILED
}

enum OutputType {
  TEXT
  FILE_PDF
  FILE_EXCEL
  FILE_WORD
  CHART
  TABLE
  WIDGET
}

model User {
  id         Int     @id @default(autoincrement())
  uuid       String  @unique @default(uuid())
  email      String  @unique
  phone      String? @unique
  first_name String?
  last_name  String?
  password   String

  role       AuthRole
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization_members OrganizationMember[]
  audit_logs           AuditLog[]
  conversations        Conversation[]
  agent_executions     AgentExecution[]

  @@index([email])
  @@index([phone])
  @@index([uuid])
  @@map("users")
}

model Organization {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  name       String
  slug       String   @unique
  logo_url   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  members    OrganizationMember[]
  roles      OrganizationRole[]
  audit_logs AuditLog[]
  integrations Integration[]
  ai_providers AiProvider[]
  conversations Conversation[]
  agent_executions AgentExecution[]

  @@index([uuid])
  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id         Int                      @id @default(autoincrement())
  uuid       String                   @unique @default(uuid())
  org_uuid   String
  user_uuid  String
  role_uuid  String
  status     OrganizationMemberStatus @default(INVITED)
  invited_at DateTime                 @default(now())
  joined_at  DateTime?

  organization Organization     @relation(fields: [org_uuid], references: [uuid], onDelete: Cascade)
  user         User             @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  role         OrganizationRole @relation(fields: [role_uuid], references: [uuid])

  @@unique([org_uuid, user_uuid])
  @@index([org_uuid])
  @@index([user_uuid])
  @@index([role_uuid])
  @@map("organization_members")
}

model OrganizationRole {
  id        Int     @id @default(autoincrement())
  uuid      String  @unique @default(uuid())
  org_uuid  String
  name      String
  is_system Boolean @default(false)

  organization Organization         @relation(fields: [org_uuid], references: [uuid], onDelete: Cascade)
  members      OrganizationMember[]
  permissions  RolePermission[]

  @@unique([org_uuid, name])
  @@index([org_uuid])
  @@map("organization_roles")
}

model Permission {
  id    Int    @id @default(autoincrement())
  uuid  String @unique @default(uuid())
  key   String @unique
  label String
  group String

  roles RolePermission[]

  @@index([key])
  @@index([group])
  @@map("permissions")
}

model RolePermission {
  id              Int    @id @default(autoincrement())
  uuid            String @unique @default(uuid())
  role_uuid       String
  permission_uuid String

  role       OrganizationRole @relation(fields: [role_uuid], references: [uuid], onDelete: Cascade)
  permission Permission       @relation(fields: [permission_uuid], references: [uuid], onDelete: Cascade)

  @@unique([role_uuid, permission_uuid])
  @@index([role_uuid])
  @@index([permission_uuid])
  @@map("role_permissions")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  org_uuid      String
  user_uuid     String
  action        String
  resource_type String
  resource_id   String?
  metadata      Json
  created_at    DateTime @default(now())

  organization Organization @relation(fields: [org_uuid], references: [uuid], onDelete: Cascade)
  user         User         @relation(fields: [user_uuid], references: [uuid])

  @@index([org_uuid])
  @@index([user_uuid])
  @@index([created_at])
  @@map("audit_logs")
}

model Integration {
  id          Int               @id @default(autoincrement())
  uuid        String            @unique @default(uuid())
  org_uuid    String
  name        String
  description String?
  provider    IntegrationProvider
  status      IntegrationStatus @default(ACTIVE)
  config      String
  metadata    Json?
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  organization Organization        @relation(fields: [org_uuid], references: [uuid], onDelete: Cascade)
  actions      IntegrationAction[]
  database     DatabaseIntegration?
  openapi      OpenApiIntegration?
  mcp          McpIntegration?
  tool_calls   ToolCall[]

  @@index([org_uuid])
  @@index([provider])
  @@index([status])
  @@map("integrations")
}

model DatabaseIntegration {
  id                Int                 @id @default(autoincrement())
  uuid              String              @unique @default(uuid())
  integration_uuid  String              @unique
  db_type           DatabaseType
  connection_string String
  schema_cache      Json?
  allowed_ops       DatabaseOperation[] @default([READ])
  last_schema_sync  DateTime?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  integration Integration @relation(fields: [integration_uuid], references: [uuid], onDelete: Cascade)

  @@index([db_type])
  @@index([last_schema_sync])
  @@map("database_integrations")
}

model OpenApiIntegration {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique @default(uuid())
  integration_uuid  String          @unique
  spec_url          String?
  spec_json         Json
  base_url          String
  auth_type         OpenApiAuthType @default(NONE)
  auth_config       String
  generated_tools   Json
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  integration Integration @relation(fields: [integration_uuid], references: [uuid], onDelete: Cascade)

  @@index([auth_type])
  @@map("openapi_integrations")
}

model McpIntegration {
  id               Int              @id @default(autoincrement())
  uuid             String           @unique @default(uuid())
  integration_uuid String           @unique
  server_url       String
  transport_type   McpTransportType @default(HTTP)
  auth_type        McpAuthType      @default(NONE)
  auth_config      String
  server_name      String?
  discovered_tools Json             @default("[]")
  last_tool_sync   DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  integration Integration @relation(fields: [integration_uuid], references: [uuid], onDelete: Cascade)

  @@index([transport_type])
  @@index([auth_type])
  @@map("mcp_integrations")
}

model IntegrationAction {
  id                      Int         @id @default(autoincrement())
  uuid                    String      @unique @default(uuid())
  integration_uuid        String
  key                     String
  label                   String
  description             String
  enabled                 Boolean     @default(true)
  requires_approval       Boolean     @default(false)
  required_permission_key String?

  integration Integration @relation(fields: [integration_uuid], references: [uuid], onDelete: Cascade)

  @@unique([integration_uuid, key])
  @@unique([uuid, integration_uuid])
  @@index([integration_uuid])
  @@index([key])
  @@map("integration_actions")
}

model Document {
  id         Int          @id @default(autoincrement())
  uuid       String       @unique @default(uuid())
  user_uuid  String
  filename   String
  mimetype   String
  size       Int
  url        String
  path       String
  type       DocumentType @default(LOGO)
  created_at DateTime     @default(now())

  @@index([user_uuid])
  @@index([uuid])
  @@map("documents")
}

model AiProvider {
  id                  Int            @id @default(autoincrement())
  uuid                String         @unique @default(uuid())
  org_uuid            String
  provider            AiProviderType
  api_key             String
  default_model       String
  model_routing       Json?
  usage_limit_tokens  Int?
  usage_limit_cost_usd Decimal?
  is_default          Boolean        @default(false)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  organization Organization @relation(fields: [org_uuid], references: [uuid], onDelete: Cascade)

  @@index([org_uuid])
  @@index([provider])
  @@map("ai_providers")
}

model Conversation {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  org_uuid   String
  user_uuid  String
  title      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization @relation(fields: [org_uuid], references: [uuid], onDelete: Cascade)
  user         User         @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  messages     Message[]
  executions   AgentExecution[]

  @@index([org_uuid])
  @@index([user_uuid])
  @@map("conversations")
}

model Message {
  id                Int         @id @default(autoincrement())
  uuid              String      @unique @default(uuid())
  conversation_uuid String
  role              MessageRole
  content           String
  metadata          Json?
  created_at        DateTime    @default(now())

  conversation Conversation    @relation(fields: [conversation_uuid], references: [uuid], onDelete: Cascade)
  executions     AgentExecution[]

  @@index([conversation_uuid])
  @@index([created_at])
  @@map("messages")
}

model AgentExecution {
  id                Int                   @id @default(autoincrement())
  uuid              String                @unique @default(uuid())
  message_uuid      String
  conversation_uuid String
  org_uuid          String
  user_uuid         String
  status            AgentExecutionStatus  @default(PENDING)
  input             Json?
  output            Json?
  tokens_used       Int                   @default(0)
  cost_usd          Decimal               @default(0)
  started_at        DateTime?
  completed_at      DateTime?
  error             String?
  created_at        DateTime              @default(now())

  message      Message      @relation(fields: [message_uuid], references: [uuid], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversation_uuid], references: [uuid], onDelete: Cascade)
  organization Organization @relation(fields: [org_uuid], references: [uuid], onDelete: Cascade)
  user         User         @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  tool_calls   ToolCall[]

  @@index([org_uuid])
  @@index([user_uuid])
  @@index([conversation_uuid])
  @@index([status])
  @@map("agent_executions")
}

model ToolCall {
  id              Int             @id @default(autoincrement())
  uuid            String          @unique @default(uuid())
  execution_uuid  String
  integration_uuid String?
  tool_name       String
  input           Json?
  output          Json?
  status          ToolCallStatus
  error           String?
  tokens_used     Int             @default(0)
  cost_usd        Decimal         @default(0)
  duration_ms     Int             @default(0)
  created_at      DateTime        @default(now())

  execution   AgentExecution @relation(fields: [execution_uuid], references: [uuid], onDelete: Cascade)
  integration Integration?   @relation(fields: [integration_uuid], references: [uuid], onDelete: SetNull)

  @@index([execution_uuid])
  @@index([integration_uuid])
  @@index([created_at])
  @@map("tool_calls")
}
